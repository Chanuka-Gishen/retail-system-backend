  successCount    Int               @default(0) @map("success_count")
  conflictCount   Int               @default(0) @map("conflict_count")
  failureCount    Int               @default(0) @map("failure_count")
  createdAt       DateTime          @default(now()) @map("created_at")

  merchant Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    OfflineSyncItem[]

  @@unique([merchantId, batchId])
  @@map("offline_sync_batches")
}

model OfflineSyncItem {
  id                String   @id @default(uuid()) @db.Uuid
  batchId           String   @map("batch_id") @db.Uuid
  clientOperationId String   @map("client_operation_id") @db.VarChar(100)
  operationType     String   @map("operation_type") @db.VarChar(50)
  status            String   @db.VarChar(20) // SUCCESS, CONFLICT, FAILED
  conflictReason    String?  @map("conflict_reason") @db.Text
  payload           Json
  result            Json?
  createdAt         DateTime @default(now()) @map("created_at")

  batch OfflineSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([clientOperationId])
  @@map("offline_sync_items")
}
