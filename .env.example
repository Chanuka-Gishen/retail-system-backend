NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
ADMIN_PORTAL_URL=http://localhost:3002
MERCHANT_PORTAL_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/retail_pos_dev?schema=public
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=50
